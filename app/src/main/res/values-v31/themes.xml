<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash shows a tape sliding into the deck, reels turning. -->
    <style name="Theme.VhsCam" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_cassette</item>
        <item name="android:windowSplashScreenAnimationDuration">900</item>
    </style>
</resources>
